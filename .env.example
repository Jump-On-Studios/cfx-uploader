# GitHub API token used to read releases and download release ZIPs.
GITHUB_TOKEN=

# CFX passkey credential values generated by `npm run register-passkey`.
CFX_UPLOADER_CREDENTIAL_ID=
CFX_UPLOADER_RP_ID=forum.cfx.re
CFX_UPLOADER_PRIVATE_KEY=
CFX_UPLOADER_USER_HANDLE=
CFX_UPLOADER_SIGN_COUNT=1

# Optional CFX username/password authentication.
# On a fresh login, the CLI may ask interactively for both the email-login link and the 2FA code.
CFX_UPLOADER_AUTH_METHOD=passkey
CFX_UPLOADER_EMAIL=
CFX_UPLOADER_PASSWORD=

# Optional encrypted authenticated-session cache.
# CFX_UPLOADER_SESSION_KEY is required when CFX_UPLOADER_SESSION_CACHE_PATH is set.
CFX_UPLOADER_SESSION_CACHE_PATH=
CFX_UPLOADER_SESSION_KEY=
CFX_UPLOADER_2FA_TIMEOUT_MS=600000
CFX_UPLOADER_EMAIL_VERIFICATION_TIMEOUT_MS=600000
CFX_UPLOADER_BROWSER_PROFILE_PATH=
# Start with native. Use normalized only when the deployment needs normalized browser metadata.
CFX_UPLOADER_HEADLESS_FINGERPRINT=native

# Optional local CLI overrides.
GITHUB_REPOSITORY=
CFX_UPLOADER_RELEASE_TAG=
CFX_SHOW_BROWSER=false
PASSKEY_CREDENTIAL_PATH=
